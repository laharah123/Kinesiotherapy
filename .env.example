# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── RevenueCat ───────────────────────────────────────────────────────────────
# Get these from: https://app.revenuecat.com → Apps → API Keys
EXPO_PUBLIC_RC_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── RevenueCat webhook (server side, NOT in the app bundle) ───────────────────
# Set with `supabase secrets set ...`, never with an EXPO_PUBLIC_ prefix.
# See supabase/functions/revenuecat-webhook/README.md
#
#   REVENUECAT_WEBHOOK_SECRET   shared bearer token; the same value goes in the
#                               RevenueCat dashboard webhook Authorization header
#   RC_MONTHLY_PRODUCT_ID       optional, defaults to com.kinesiotherapy.monthly
#   RC_YEARLY_PRODUCT_ID        optional, defaults to com.kinesiotherapy.yearly
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into edge functions by
# Supabase. The service role key must never reach the client.
